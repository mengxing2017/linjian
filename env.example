# This file is an example. Generate separate Linjian secrets; do not reuse sender credentials.
LINJIAN_DATABASE_PASSWORD=
LINJIAN_PUBLIC_ORIGIN=https://forum.example.com
LINJIAN_WEB_LISTEN=forum.example.com
LINJIAN_HTTP_PORT=8091
LINJIAN_HTTPS_PORT=8444
LINJIAN_INSECURE_LOCAL_AUTH=false
# Independent miniapp credentials; never VITE_* variables.
LINJIAN_WX_APP_ID=
LINJIAN_WX_SECRET=
# 审核通过后异步准备来源摘要和链接。关闭仅暂停准备，不影响撤回。
LINJIAN_MINIAPP_SOURCE_ENABLED=true
LINJIAN_MINIAPP_LINK_TYPE=short_link
LINJIAN_MINIAPP_SHORT_LINK_PERMANENT=false
LINJIAN_MINIAPP_URL_LINK_DAYS=30
LINJIAN_MINIAPP_LINK_MIN_REMAINING_SECONDS=86400
LINJIAN_MINIAPP_PREPARATION_CONCURRENCY=2
# Optional forum account-directory / OAuth integration; no group sending capability.
LINJIAN_WECOM_CORP_ID=
LINJIAN_WECOM_AGENT_ID=
LINJIAN_WECOM_SECRET=
# WeKeeper v2：同一组配置同时填写；全部留空表示尚未接入。
# 仅填写规范 HTTPS origin，不带路径、query 或末尾斜杠。
LINJIAN_WEKEEPER_ORIGIN=
# 从 WeKeeper“调用方凭据”复制同一条凭据的 key_id 和 secret。
LINJIAN_WEKEEPER_KEY_ID=
LINJIAN_WEKEEPER_SECRET=
# secret 仅由后端从此配置读取用于 HMAC 签名，不入库、不回显、不传入前端构建。
# 不需要 LINJIAN_SOURCE_MASTER_KEY_V1，也不要填写 WeKeeper 的存储主密钥。

# Comma-separated trusted proxy IPs; empty means ignore forwarded client-IP headers.
LINJIAN_TRUSTED_PROXY_IPS=
