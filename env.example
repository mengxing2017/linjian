# This file is an example. Generate separate Linjian secrets; do not reuse sender credentials.
LINJIAN_DATABASE_PASSWORD=
LINJIAN_PUBLIC_ORIGIN=https://forum.example.com
LINJIAN_WEB_LISTEN=forum.example.com
LINJIAN_HTTP_PORT=8091
LINJIAN_HTTPS_PORT=8444
LINJIAN_INSECURE_LOCAL_AUTH=false
# Independent miniapp credentials; never VITE_* variables.
LINJIAN_WX_APP_ID=
LINJIAN_WX_SECRET=
# Optional forum account-directory / OAuth integration; no group sending capability.
LINJIAN_WECOM_CORP_ID=
LINJIAN_WECOM_AGENT_ID=
LINJIAN_WECOM_SECRET=
# Leave all three empty until the receiving service is available. Events stay durable.
LINJIAN_SOURCE_ENDPOINT=
LINJIAN_SOURCE_KEY_ID=
LINJIAN_SOURCE_SECRET=
