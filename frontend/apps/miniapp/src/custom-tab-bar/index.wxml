<view wx:if="{{ready}}" class="bottom-navigation" style="{{theme}}" role="navigation" aria-label="主导航">
  <button wx:for="{{items}}" wx:key="id" class="nav-item {{selected === item.id ? 'selected' : ''}} {{item.id === 'publish' ? 'publish-item' : ''}}" data-id="{{item.id}}" bindtap="activate" aria-label="{{item.label}}{{item.id === 'messages' && badge ? '，未读消息' + badge : ''}}">
    <view wx:if="{{item.id === 'publish'}}" class="publish-circle"><image wx:if="{{!failedSources[item.icon]}}" class="publish-icon" src="{{item.icon}}" mode="aspectFit" data-source="{{item.icon}}" binderror="iconError" aria-hidden="true" /><text wx:else class="publish-fallback">发布</text></view>
    <block wx:else>
      <view class="icon-wrap"><image wx:if="{{!failedSources[selected === item.id ? item.selectedIcon : item.icon]}}" class="nav-icon-image" src="{{selected === item.id ? item.selectedIcon : item.icon}}" mode="aspectFit" data-source="{{selected === item.id ? item.selectedIcon : item.icon}}" binderror="iconError" aria-hidden="true" /><view wx:else class="icon-placeholder"></view><view wx:if="{{item.id === 'messages' && badge}}" class="badge">{{badge}}</view></view>
      <text class="nav-label">{{item.label}}</text>
    </block>
  </button>
</view>
